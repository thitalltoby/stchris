// St. Chris Materials Desk: PostgreSQL schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity and access ───────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OPS_ADMIN
  OPS_STAFF
  COMMERCIAL
  APPROVER
  /// Writes and publishes the journal, media centre and executive profile
  CONTENT_MANAGER
  /// Journal, media centre, social publishing and staff announcements
  COMMUNICATIONS
  /// Internal employee: staff portal only, no operations console
  STAFF_MEMBER
  CUSTOMER
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             Role      @default(CUSTOMER)
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Largest quotation total (in the base currency) this approver may approve. Null = no limit.
  approvalLimit    Decimal?  @db.Decimal(18, 2)
  /// AES-256-GCM encrypted TOTP secret (staff two-factor sign-in). Set during enrolment, active once mfaEnabledAt is set.
  mfaSecretEnc     String?
  mfaEnabledAt     DateTime?
  /// Last accepted 30-second time step; a code can be used only once
  mfaLastStep      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges    MfaChallenge[]
  authTokens       AuthToken[]
  memberships      CompanyMembership[]
  contacts         Contact[]
  assignedRequests QuoteRequest[]  @relation("RequestAssignee")
  projectLists     ProjectList[]
  ownedCompanies   Company[]           @relation("RelationshipOwner")
  tasks            Task[]              @relation("TaskAssignee")
  quotationsMade   Quotation[]         @relation("QuotationCreator")
  articles         Article[]
  staffProfile     StaffProfile?
  staffPostsWritten StaffPost[]
  staffPostReads   StaffPostRead[]
  socialAccountsConnected SocialAccount[]

  @@index([role, isActive])
}

model MfaRecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the normalised code; the code itself is shown once at enrolment
  codeHash String
  usedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A password-verified sign-in waiting for its second factor. Not a session.
model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  next      String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the opaque cookie token; the raw token is never stored
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ─── Companies and contacts (lightweight CRM) ─────────────────────

model Company {
  id           String   @id @default(cuid())
  name         String
  industry     String?
  website      String?
  address      String?
  notes        String?
  ownerId      String?
  owner        User?    @relation("RelationshipOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts     Contact[]
  memberships  CompanyMembership[]
  invites      CompanyInvite[]
  requests     QuoteRequest[]
  quotations   Quotation[]
  tasks        Task[]
  communications Communication[]
  documents    Document[]
  projectLists ProjectList[]

  @@index([name])
}

enum MembershipRole {
  OWNER
  MEMBER
}

model CompanyMembership {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model CompanyInvite {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String    @unique
  invitedById String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  jobTitle  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Set when the contact has a verified portal account
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests       QuoteRequest[]
  quotations     Quotation[]
  communications Communication[]

  @@unique([email, companyId])
  @@index([email])
  @@index([userId])
}

// ─── Services and configurable request fields ─────────────────────

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  DATE
  BOOLEAN
}

model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  pillar        String
  summary       String
  description   String   // Markdown
  highlights    Json     @default("[]")
  instructions  String?  // shown in the request builder once the service is chosen
  /// The request carries the customer's project list (catalogue lines with quantities)
  acceptsItems  Boolean  @default(false)
  icon          String   @default("route")
  imageKey      String?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Department that receives this kind of request (key of the departments setting)
  department    String   @default("sales")
  /// Group on the opportunities page: "buy", "partner" or "connect"
  audience      String   @default("buy")
  /// Content taken from company materials that St. Chris has not yet confirmed for publication
  needsReview   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fields        ServiceField[]
  requests      QuoteRequest[]

  @@index([visible, sortOrder])
}

model ServiceField {
  id         String    @id @default(cuid())
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       FieldType @default(TEXT)
  required   Boolean   @default(false)
  options    Json?     // string[] for SELECT
  unit       String?   // fixed unit label for NUMBER, e.g. "tonnes"
  helpText   String?
  placeholder String?
  section    String    @default("Requirement")
  sortOrder  Int       @default(0)
  visible    Boolean   @default(true)

  @@unique([serviceId, key])
  @@index([serviceId, sortOrder])
}

// ─── Logistics requests ───────────────────────────────────────────

enum RequestStatus {
  RECEIVED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  QUOTATION_IN_PREPARATION
  QUOTATION_ISSUED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
  CLOSED
  EXPIRED
}

model QuoteRequest {
  id              String        @id @default(cuid())
  reference       String        @unique
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  status          RequestStatus @default(RECEIVED)
  /// Answers keyed by ServiceField.key
  details         Json
  /// Labels (and units) as shown to the customer at submission time, so later edits to the service form do not rewrite history
  detailLabels    Json
  summary         String?
  recurrence      String        @default("ONE_OFF")
  neededFrom      DateTime?
  neededBy        DateTime?
  origin          String?
  destination     String?
  source          String?
  idempotencyKey  String?       @unique

  requesterName   String
  requesterEmail  String
  requesterPhone  String?
  /// The customer ticked the box to receive status messages on this channel for this request
  smsOptIn        Boolean       @default(false)
  whatsappOptIn   Boolean       @default(false)
  companyName     String?

  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Set when submitted from a signed-in portal account
  submittedByUserId String?
  /// Department the request was routed to when it was submitted (copied from the service)
  department      String        @default("sales")

  assigneeId      String?
  assignee        User?         @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  repeatOfId      String?
  nextFollowUpAt  DateTime?
  closedReason    String?
  submittedAt     DateTime      @default(now())
  statusChangedAt DateTime      @default(now())
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  history         StatusHistory[]
  communications  Communication[]
  infoRequests    InfoRequest[]
  tasks           Task[]
  quotations      Quotation[]
  documents       Document[]
  items           QuoteRequestItem[]

  @@index([status, submittedAt])
  @@index([serviceId])
  @@index([assigneeId, status])
  @@index([companyId])
  @@index([contactId])
  @@index([requesterEmail])
  @@index([submittedByUserId])
  @@index([submittedAt])
  @@index([department, status])
}

model StatusHistory {
  id          String         @id @default(cuid())
  requestId   String
  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  actorId     String?
  actorLabel  String         // staff name, "Customer", or "System"
  note        String?
  createdAt   DateTime       @default(now())

  @@index([requestId, createdAt])
}

enum CommType {
  NOTE        // internal only
  MESSAGE     // shared with the customer
  EMAIL
  CALL
  MEETING
  WHATSAPP
  SMS
}

enum CommDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model Communication {
  id          String        @id @default(cuid())
  type        CommType
  direction   CommDirection @default(INTERNAL)
  subject     String?
  body        String
  /// Only customer-visible items appear in the portal. Internal notes are never visible.
  customerVisible Boolean   @default(false)
  requestId   String?
  request     QuoteRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  authorId    String?
  authorLabel String
  occurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([requestId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([contactId])
}

enum InfoRequestStatus {
  OPEN
  ANSWERED
  CANCELLED
}

model InfoRequest {
  id          String            @id @default(cuid())
  requestId   String
  request     QuoteRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  question    String
  status      InfoRequestStatus @default(OPEN)
  askedById   String?
  askedByLabel String
  answer      String?
  answeredByLabel String?
  answeredAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([requestId, status])
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  notes       String?
  dueAt       DateTime
  status      TaskStatus @default(OPEN)
  requestId   String?
  request     QuoteRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdByLabel String
  /// "AUTO" when created by a workflow rule
  origin      String     @default("MANUAL")
  completedAt DateTime?
  reminderSentAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([requestId])
}

// ─── Quotations ───────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  SUPERSEDED
}

model Quotation {
  id          String   @id @default(cuid())
  number      String   @unique
  requestId   String
  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Mirrors the status of the newest revision
  status      QuotationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions   QuotationRevision[]
  decisions   QuotationDecision[]
  documents   Document[]

  @@index([requestId])
  @@index([status])
  @@index([companyId])
}

model QuotationRevision {
  id            String          @id @default(cuid())
  quotationId   String
  quotation     Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version       Int
  status        QuotationStatus @default(DRAFT)
  title         String?
  currency      String          @default("NGN")
  introduction  String?
  terms         String?
  paymentTerms  String?
  validityDays  Int             @default(14)
  issuedAt      DateTime?
  validUntil    DateTime?
  subtotal      Decimal         @default(0) @db.Decimal(18, 2)
  discountTotal Decimal         @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(18, 2)
  total         Decimal         @default(0) @db.Decimal(18, 2)
  submittedAt   DateTime?
  approvedAt    DateTime?
  firstViewedAt DateTime?
  createdById   String?
  createdByLabel String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lineItems     QuotationLineItem[]
  approvals     QuotationApproval[]
  decisions     QuotationDecision[]

  @@unique([quotationId, version])
  @@index([status, validUntil])
}

model QuotationLineItem {
  id          String   @id @default(cuid())
  revisionId  String
  revision    QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  description String
  unit        String   @default("each")
  quantity    Decimal  @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @db.Decimal(7, 4)
  taxPercent  Decimal  @default(0) @db.Decimal(7, 4)
  /// Computed on save and kept for reporting: quantity × price, less discount, before tax
  lineNet     Decimal  @db.Decimal(18, 2)
  lineTax     Decimal  @db.Decimal(18, 2)
  /// Set when the line was picked from the catalogue (kept as plain ids so a later catalogue change never rewrites a quotation)
  productId   String?
  variantId   String?
  sku         String?

  @@index([revisionId, sortOrder])
}

enum ApprovalDecision {
  SUBMITTED
  APPROVED
  REJECTED
}

model QuotationApproval {
  id          String           @id @default(cuid())
  revisionId  String
  revision    QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  decision    ApprovalDecision
  actorId     String?
  actorLabel  String
  comment     String?
  createdAt   DateTime         @default(now())

  @@index([revisionId, createdAt])
}

enum CustomerDecision {
  ACCEPTED
  DECLINED
}

model QuotationDecision {
  id          String           @id @default(cuid())
  quotationId String
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionId  String
  revision    QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  decision    CustomerDecision
  /// The customer account that answered online. Null when staff recorded an offline answer.
  userId      String?
  decidedByName  String
  decidedByEmail String
  comment     String?
  ip          String?
  /// ONLINE, or how the customer answered offline: PHONE, PAPER, EMAIL, WHATSAPP, MEETING
  channel     String           @default("ONLINE")
  /// Staff member who recorded an offline answer
  recordedById    String?
  recordedByName  String?
  /// When the customer actually gave the answer (offline answers are recorded later)
  occurredAt  DateTime?
  /// Customer's own reference, e.g. purchase order or signed-form number
  reference   String?
  evidenceDocumentId String?
  createdAt   DateTime         @default(now())

  @@index([quotationId])
  @@index([revisionId])
}

// ─── Documents (private) ──────────────────────────────────────────

enum ScanStatus {
  PENDING    // waiting for the scanner
  CLEAN
  INFECTED   // quarantined: never served
  ERROR      // scanner unavailable or failed: never served until a rescan succeeds
  UNSCANNED  // uploaded before scanning existed
}

enum DocumentVisibility {
  INTERNAL   // staff only
  CUSTOMER   // staff and the customer who owns the request
  PUBLIC     // published corporate documents
}

model Document {
  id           String             @id @default(cuid())
  storageKey   String             @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  visibility   DocumentVisibility @default(INTERNAL)
  title        String?
  requestId    String?
  request      QuoteRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quotationId  String?
  quotation    Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedByLabel String
  /// For PUBLIC documents: the website section page it is listed on (e.g. "sustainability/environment/impact-assessment-reports")
  section      String?
  scanStatus   ScanStatus         @default(PENDING)
  /// "clamav" (a clamd daemon) or "builtin" (signature and file-structure checks only)
  scanEngine   String?
  scanDetail   String?
  scannedAt    DateTime?
  createdAt    DateTime           @default(now())
  staffDocument StaffDocument?

  @@index([requestId])
  @@index([companyId])
  @@index([visibility])
  @@index([scanStatus])
  @@index([section])
}

// ─── Catalogue ────────────────────────────────────────────────────

enum Availability {
  ON_REQUEST   // we confirm stock and lead time in the quotation
  IN_STOCK
  ON_ORDER     // sourced against the order
  DISCONTINUED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// One line shown on cards
  summary     String
  description String   @default("")   // Markdown
  /// string[]: the product lines in this category, from company materials. Each can be added to a project list as a line to quote.
  range       Json     @default("[]")
  /// Supplied photo key or media:<id>
  imageKey    String?
  /// Which part of the business it belongs to, for grouping on the home page ("Building", "Bathroom & kitchen", "Finishing")
  groupLabel  String   @default("Building")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  /// Wording taken from company materials that has not yet been confirmed for publication
  needsReview Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([visible, sortOrder])
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  website   String?
  note      String   @default("")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())

  products  Product[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  summary     String
  description String        @default("")   // Markdown
  /// string[]: short selling points
  highlights  Json          @default("[]")
  /// [{label, value}]: the specification table
  specs       Json          @default("[]")
  /// string[] of supplied photo keys or media:<id>, first is the main image
  imageKeys   Json          @default("[]")
  status      PublishStatus @default(DRAFT)
  featured    Boolean       @default(false)
  /// Anything on the page taken from supplied material that still needs confirming (brand, claims, specifications)
  needsReview Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants    ProductVariant[]

  @@index([categoryId, status, sortOrder])
  @@index([status, featured])
}

model ProductVariant {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Staff-assigned code. Optional: the catalogue works without one.
  sku          String?      @unique
  /// What the customer picks, for example "5,000 L" or "600 × 600 mm"
  label        String
  unit         String       @default("each")
  /// Internal price-book value used to pre-fill a quotation line; shown publicly only when the "show prices" setting is on
  price        Decimal?     @db.Decimal(18, 2)
  availability Availability @default(ON_REQUEST)
  minQuantity  Decimal?     @db.Decimal(18, 4)
  sortOrder    Int          @default(0)
  visible      Boolean      @default(true)

  @@index([productId, sortOrder])
}

// ─── Project lists (the working basket) ──────────────────────────

enum ListKind {
  ACTIVE   // the list being built right now (one per visitor)
  SAVED    // a named list kept for re-use or re-ordering
}

model ProjectList {
  id        String      @id @default(cuid())
  /// Browser token for a guest's active list (hashed)
  tokenHash String?     @unique
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  kind      ListKind    @default(ACTIVE)
  name      String      @default("Project list")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items     ProjectListItem[]

  @@index([userId, kind])
}

model ProjectListItem {
  id        String      @id @default(cuid())
  listId    String
  list      ProjectList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Null for a free-text line ("something not in the catalogue")
  productId String?
  variantId String?
  label     String
  unit      String      @default("each")
  quantity  Decimal     @default(1) @db.Decimal(18, 4)
  note      String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([listId, sortOrder])
}

/// The lines a customer asked us to quote. A snapshot, so later catalogue edits never rewrite what was asked.
model QuoteRequestItem {
  id        String       @id @default(cuid())
  requestId String
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String?
  variantId String?
  sku       String?
  label     String
  unit      String       @default("each")
  quantity  Decimal      @db.Decimal(18, 4)
  note      String?
  sortOrder Int          @default(0)

  @@index([requestId, sortOrder])
}

// ─── Website content ──────────────────────────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── Notifications, jobs, integrations, audit ─────────────────────

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model NotificationEvent {
  id                String             @id @default(cuid())
  type              String
  channel           String             @default("EMAIL")
  toAddress         String
  subject           String
  body              String
  status            NotificationStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  requestId         String?
  attempts          Int                @default(0)
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([requestId])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}

model Integration {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  category      String
  enabled       Boolean  @default(false)
  config        Json     @default("{}")
  /// AES-256-GCM encrypted JSON of secret values, keyed by APP_SECRET
  secretEnc     String?
  lastCheckedAt DateTime?
  lastStatus    String?
  lastMessage   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs          IntegrationLog[]
}

model IntegrationLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event         String
  status        String
  requestSummary  String?
  responseSummary String?
  error         String?
  durationMs    Int?
  createdAt     DateTime    @default(now())

  @@index([integrationId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}


// ─── Executive profile, divisions and opportunities ───────────────

/// Career, leadership, milestone and testimonial entries. scope "chris" feeds the executive profile and the
/// Leadership, Career & Opportunities page; scope "geepee" feeds the GeePee Tanks partnership feature.
/// Nothing is shown until staff add it: the site never invents dates or quotations.
model TimelineEntry {
  id          String   @id @default(cuid())
  scope       String
  /// CAREER, LEADERSHIP, TRAINING, MILESTONE, TESTIMONIAL, INTERVIEW
  kind        String
  /// Free text such as "2009" or "2009 to 2014"
  period      String   @default("")
  title       String
  body        String   @default("")
  /// Who said it, for testimonials and interviews
  attribution String?
  imageKey    String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, kind, sortOrder])
}

model Division {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  summary      String
  description  String   // Markdown
  highlights   Json     @default("[]")
  /// Product or service lines, shown as chips
  offerings    Json     @default("[]")
  /// Catalogue category slugs this division links to
  categorySlugs Json    @default("[]")
  /// Request type (Service slug) behind the "Enquire" button
  serviceSlug  String?
  imageKey     String?
  icon         String   @default("box")
  visible      Boolean  @default(true)
  sortOrder    Int      @default(0)
  needsReview  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visible, sortOrder])
}

/// A concrete opening: a role, a distribution territory, a tender. Empty until staff post one.
model Opportunity {
  id          String        @id @default(cuid())
  slug        String        @unique
  /// CAREER, DISTRIBUTION, PARTNERSHIP, SUPPLIER, PROCUREMENT, INVESTMENT
  kind        String
  title       String
  summary     String
  body        String        @default("")
  location    String?
  closesOn    DateTime?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

// ─── Journal ──────────────────────────────────────────────────────

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  /// Taken off the site; kept so it can be restored
  ARCHIVED
}

model ArticleCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  articles    Article[]
}

model Article {
  id               String          @id @default(cuid())
  slug             String          @unique
  /// ARTICLE, or FEATURE for long-form pieces such as the GeePee Tanks story
  kind             String          @default("ARTICLE")
  title            String
  subtitle         String?
  excerpt          String          @default("")
  /// Markdown
  body             String          @default("")
  status           ArticleStatus   @default(DRAFT)
  publishedAt      DateTime?
  scheduledFor     DateTime?
  categoryId       String
  category         ArticleCategory @relation(fields: [categoryId], references: [id])
  tags             Json            @default("[]")
  /// A bundled photo key or "media:<id>"
  featuredImageKey String?
  featuredImageAlt String?
  /// YouTube or Vimeo address, or "media:<id>" for an uploaded video
  videoUrl         String?
  seoTitle         String?
  seoDescription   String?
  readingMinutes   Int             @default(1)
  authorId         String
  author           User            @relation(fields: [authorId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  views            ArticleView[]
  social           SocialPost[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([authorId])
  @@index([status, scheduledFor])
}

/// Daily readership counts, kept without personal data
model ArticleView {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  day       String  // YYYY-MM-DD, Lagos time
  count     Int     @default(0)

  @@id([articleId, day])
}

// ─── Media centre ─────────────────────────────────────────────────

model MediaItem {
  id          String        @id @default(cuid())
  /// PRESS_RELEASE, INTERVIEW, PUBLICATION, SPEAKING, CONFERENCE, ANNOUNCEMENT, COMMENTARY, MENTION, PHOTO, VIDEO
  kind        String
  title       String
  summary     String        @default("")
  body        String        @default("")
  /// Publication, outlet, organiser or event name
  source      String?
  /// Link to the original piece, event or recording
  url         String?
  eventDate   DateTime?
  location    String?
  imageKey    String?
  videoUrl    String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([kind, status, eventDate])
  @@index([status, eventDate])
}

// ─── Social publishing ────────────────────────────────────────────

model SocialAccount {
  id             String    @id @default(cuid())
  /// linkedin, facebook, instagram, x
  platform       String
  displayName    String
  /// Page id, organisation or person URN, Instagram business account id, or X user id
  externalId     String
  /// AUTO posts through the platform's API; MANUAL only prepares the post and notifies the team
  mode           String    @default("AUTO")
  /// CONNECTED, NEEDS_ATTENTION, DISABLED
  status         String    @default("CONNECTED")
  /// AES-256-GCM encrypted access token, keyed by APP_SECRET
  secretEnc      String?
  tokenExpiresAt DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  connectedById  String?
  connectedBy    User?     @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  posts          SocialPost[]

  @@unique([platform, externalId])
}

enum SocialPostStatus {
  /// Prepared; waiting for the article to be published
  PENDING
  /// Waiting for the worker
  QUEUED
  PUBLISHED
  FAILED
  /// The platform cannot take this automatically (or the account is manual): the team posts it by hand
  NEEDS_MANUAL
  CANCELLED
}

model SocialPost {
  id          String           @id @default(cuid())
  articleId   String
  article     Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  accountId   String
  account     SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  caption     String
  hashtags    Json             @default("[]")
  includeLink Boolean          @default(true)
  status      SocialPostStatus @default(PENDING)
  attempts    Int              @default(0)
  externalId  String?
  externalUrl String?
  error       String?
  /// Why a post needs manual publishing, in plain words
  note        String?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([articleId, accountId])
  @@index([status, updatedAt])
}

// ─── Staff portal ─────────────────────────────────────────────────

model StaffProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String   @default("")
  department      String   @default("")
  location        String   @default("")
  /// Work phone or extension
  phone           String   @default("")
  about           String   @default("")
  showInDirectory Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

enum StaffPostKind {
  ANNOUNCEMENT
  CIRCULAR
  DEPARTMENT
  TRAINING
  OPPORTUNITY
  MANAGEMENT
}

model StaffPost {
  id         String        @id @default(cuid())
  kind       StaffPostKind @default(ANNOUNCEMENT)
  title      String
  body       String
  /// Department key; empty means everyone
  department String        @default("")
  pinned     Boolean       @default(false)
  status     PublishStatus @default(DRAFT)
  publishedAt DateTime?
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reads      StaffPostRead[]

  @@index([status, publishedAt])
}

model StaffPostRead {
  postId String
  post   StaffPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime  @default(now())

  @@id([postId, userId])
}

/// Approved internal documents. The file lives in the private document store and is served only to signed-in staff.
model StaffDocument {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  category     String   @default("General")
  department   String   @default("")
  documentId   String   @unique
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  visible      Boolean  @default(true)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([visible, category])
}

// ─── SEO ──────────────────────────────────────────────────────────

model SeoEntry {
  path        String   @id
  title       String?
  description String?
  ogImageKey  String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
